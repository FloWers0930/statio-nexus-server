# ====================== GENERAL ======================
NODE_ENV=development
PORT=5000

# ====================== DATABASE ======================
# MongoDB connection URI
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=StatioNexusBlockchain
# Bcrypt salt rounds for password hashing
SALT=10

# ====================== JWT TOKENS ======================
# JWT secret key for access tokens (min 32 chars)
JWT_SECRET=your-secret-key-min-32-characters-long
# JWT secret key for refresh tokens (min 32 chars)
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-characters-long
# Access token expiration (e.g., 15m, 1h)
JWT_EXPIRES_IN=15m
# Refresh token expiration (e.g., 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ====================== SEEDING ======================
# Set to true to seed demo data on startup
SEED_DEMO_DATA=true
# Default admin password for seeding
ADMIN_SEED_PASS=AdminPass123!
# Default owner password for seeding
OWNER_SEED_PASS=OwnerPass123!

# ====================== CORS ======================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5500

# ====================== EMAIL CONFIGURATION ======================
# Email provider: smtp
EMAIL_PROVIDER=smtp
# SMTP server host
SMTP_HOST=smtp.gmail.com
# SMTP server port
SMTP_PORT=587
# SMTP username/email
SMTP_USER=your-email@gmail.com
# SMTP password or app password
SMTP_PASS=your-gmail-app-password
# Use TLS encryption
SMTP_SECURE=false
# Email sender address
EMAIL_FROM=noreply@statio-nexus.com
# Email sender name
EMAIL_FROM_NAME=Statio Nexus Support
# Support email address
SUPPORT_EMAIL=support@statio-nexus.com
# Frontend URL for email links
FRONTEND_URL=http://localhost:5173

# ====================== WEB PUSH NOTIFICATIONS ======================
# VAPID public key (generated with web-push)
VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID private key (generated with web-push)
VAPID_PRIVATE_KEY=your-vapid-private-key
# Email for VAPID certificate
VAPID_EMAIL=admin@statio-nexus.com

# ====================== BLOCKCHAIN (HYPERLEDGER BESU) ======================
# Besu RPC endpoint URL
BESU_RPC_URL=http://localhost:8545
# Smart contract address for TransactionLedger
CONTRACT_ADDRESS=0x3b0bcB565E3c6Ee1bEC2ecFc221f4131c7E67e99
# Server wallet private key (for blockchain transactions)
SERVER_WALLET_PRIVATE_KEY=0xf61b0e4f6eb4fb74349d4177f8a9b85a88663139c0726df18cca578912a658db

# ====================== SECURITY ======================
# Bcrypt rounds (higher = slower but more secure, 10-12 recommended)
BCRYPT_ROUNDS=12
# Rate limit window in milliseconds (15 min default)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ====================== LOGGING ======================
# Log level: debug | info | warn | error
LOG_LEVEL=info

# ====================== OPTIONAL: ERROR TRACKING ======================
# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=
